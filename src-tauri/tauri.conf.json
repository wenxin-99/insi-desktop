{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Insi Desktop",
  "version": "0.8.0",
  "identifier": "ren.insights.desktop",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Insi Desktop Agent",
        "width": 420,
        "height": 720,
        "resizable": false,
        "center": true,
        "visible": true,
        "decorations": true,
        "skipTaskbar": false,
        "closable": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true,
      "tooltip": "Insi Desktop Agent"
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://insights.ren https://insiapp.cn wss://insights.ren wss://insiapp.cn https://*.insights.ren; img-src 'self' data: https://insights.ren https://insiapp.cn; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Insi AI (insights.ren)",
    "category": "Utility",
    "shortDescription": "AI 桌面控制代理",
    "longDescription": "Insi Desktop Agent — 让 AI 像真人一样操作你的电脑。连接 insights.ren 平台，通过自然语言指令控制桌面操作。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libappindicator3-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/wenxin-99/insi-desktop/releases/latest/download/update-manifest.json",
        "https://insights.ren/api/desktop/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3Q0ZBQ0Y0QzY1RURENEIKUldSTDNWN0c5S3pQZDNrKzBNVUdUdk4ybDZBQnZxRmpIZy9rVFZ2Z1JzSUF6MWF4VGpCYVdXMmwK"
    }
  }
}